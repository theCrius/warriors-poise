{
  "$schema": "https://bonsaibauer.github.io/shroudforge/schemas/extended.mod.schema.json",
  "schemaVersion": 1,
  "enabled": true,
  "targets": [
    "client",
    "server"
  ],
  "launcher": "SF",
  "settings": {
    "swingCancel": {
      "value": false,
      "label": "Swing cancel",
      "description": "Block or dodge out of a melee attack during its wind-up, heavy attacks included. You stay committed only during the swing itself, and recover sooner after it.",
      "control": "toggle",
      "applyAt": "restart",
      "restartRequired": true,
      "assetPreparation": true
    },
    "armourDefence": {
      "value": false,
      "label": "Stronger armour",
      "description": "Multiplies the physical and magical defence of every armour piece. Each armour type keeps its own balance between the two.",
      "control": "toggle",
      "applyAt": "restart",
      "restartRequired": true,
      "assetPreparation": true
    },
    "armourDefenceMultiplier": {
      "value": 1.25,
      "label": "Armour multiplier",
      "description": "How much stronger armour gets: 1.25 means 25% more defence.",
      "control": "slider",
      "min": 1,
      "max": 2,
      "step": 0.05,
      "enabledWhen": {
        "setting": "armourDefence",
        "equals": true
      },
      "applyAt": "restart",
      "restartRequired": true,
      "assetPreparation": true
    },
    "poise": {
      "value": false,
      "label": "Poise",
      "description": "Your armour and shield absorb hits. Light, Medium and Heavy hits drain your poise and only make you twitch until it runs out. Poise refills when you have not been hit for a moment. Boss hits, stuns and knockdowns always land.",
      "control": "toggle",
      "applyAt": "restart",
      "restartRequired": true,
      "assetPreparation": true
    },
    "poiseHeavyArmour": {
      "value": 10,
      "label": "Heavy armour piece",
      "description": "Poise from each heavy piece (Warrior armour).",
      "control": "slider",
      "min": 0,
      "max": 30,
      "step": 1,
      "enabledWhen": {
        "setting": "poise",
        "equals": true
      },
      "applyAt": "restart",
      "restartRequired": true,
      "assetPreparation": true
    },
    "poiseMediumArmour": {
      "value": 6,
      "label": "Medium armour piece",
      "description": "Poise from each medium piece (Ranger armour, mixed sets).",
      "control": "slider",
      "min": 0,
      "max": 30,
      "step": 1,
      "enabledWhen": {
        "setting": "poise",
        "equals": true
      },
      "applyAt": "restart",
      "restartRequired": true,
      "assetPreparation": true
    },
    "poiseLightArmour": {
      "value": 3,
      "label": "Light armour piece",
      "description": "Poise from each light piece (Mage armour, cloth).",
      "control": "slider",
      "min": 0,
      "max": 30,
      "step": 1,
      "enabledWhen": {
        "setting": "poise",
        "equals": true
      },
      "applyAt": "restart",
      "restartRequired": true,
      "assetPreparation": true
    },
    "poiseShield": {
      "value": 30,
      "label": "Shield",
      "description": "Poise from an equipped shield, raised or not. Two-handed weapons get none.",
      "control": "slider",
      "min": 0,
      "max": 100,
      "step": 5,
      "enabledWhen": {
        "setting": "poise",
        "equals": true
      },
      "applyAt": "restart",
      "restartRequired": true,
      "assetPreparation": true
    },
    "poiseLightHit": {
      "value": 5,
      "label": "Light hit cost",
      "description": "Poise a Light hit removes.",
      "control": "slider",
      "min": 0,
      "max": 100,
      "step": 1,
      "enabledWhen": {
        "setting": "poise",
        "equals": true
      },
      "applyAt": "restart",
      "restartRequired": true,
      "assetPreparation": true
    },
    "poiseMediumHit": {
      "value": 10,
      "label": "Medium hit cost",
      "description": "Poise a Medium hit removes.",
      "control": "slider",
      "min": 0,
      "max": 100,
      "step": 1,
      "enabledWhen": {
        "setting": "poise",
        "equals": true
      },
      "applyAt": "restart",
      "restartRequired": true,
      "assetPreparation": true
    },
    "poiseHeavyHit": {
      "value": 50,
      "label": "Heavy hit cost",
      "description": "Poise a Heavy hit removes.",
      "control": "slider",
      "min": 0,
      "max": 100,
      "step": 1,
      "enabledWhen": {
        "setting": "poise",
        "equals": true
      },
      "applyAt": "restart",
      "restartRequired": true,
      "assetPreparation": true
    },
    "poiseRefillSeconds": {
      "value": 3,
      "label": "Refill delay",
      "description": "Seconds without a poise hit before poise is full again.",
      "control": "slider",
      "min": 1,
      "max": 10,
      "step": 0.5,
      "enabledWhen": {
        "setting": "poise",
        "equals": true
      },
      "applyAt": "restart",
      "restartRequired": true,
      "assetPreparation": true
    }
  }
}
